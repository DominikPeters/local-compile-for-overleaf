{
  "manifest_version": 3,
  "name": "Local Compile for Overleaf",
  "version": "0.1.0",
  "description": "Unofficial helper to compile Overleaf projects locally and feed the result into Overleaf's PDF preview.",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://*.overleaf.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://*.overleaf.com/project/*",
        "http://localhost/project/*",
        "http://127.0.0.1/project/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-shim.js"],
      "matches": [
        "https://www.overleaf.com/*",
        "https://*.overleaf.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
