{
  "manifest_version": 3,
  "name": "Local Compile for Overleaf",
  "version": "0.1.0",
  "description": "Unofficial helper to compile Overleaf projects locally and feed the result into Overleaf's PDF preview.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Local Compile for Overleaf",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://*.overleaf.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://*.overleaf.com/project/*",
        "http://localhost/project/*",
        "http://127.0.0.1/project/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-shim.js"],
      "matches": [
        "https://www.overleaf.com/*",
        "https://*.overleaf.com/*",
        "https://*/*",
        "http://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
